# Unityプロジェクトのルート（Assets/ と同じ階層）に置いてください

# Unityが自動生成するフォルダ
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# エディタ・IDEの設定
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# IDEが自動生成するファイル
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# クラッシュログなど
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# ビルド成果物・パッケージ
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OSのファイル
.DS_Store
Thumbs.db
desktop.ini
